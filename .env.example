# Ortam şablonu — bu dosyayı `.env` olarak kopyala ve gerçek değerleri gir.
# .env ASLA repoya commit edilmez (.gitignore'da). Bu .env.example commit edilir.
# Buradaki değerler PLACEHOLDER'dır — gerçek secret DEĞİL.

# --- Zorunlu ---
BASE_URL=https://test-ortami.example
ADMIN_USER=degistir-beni
ADMIN_PASS=degistir-beni

# --- Opsiyonel: çalıştırma ---
# Yerel debug için HEADLESS=false ile tarayıcıyı göster.
HEADLESS=true

# --- Opsiyonel: Keycloak / Auth ---
# AUTH_URL boşsa token akışı atlanır (auth gerektirmeyen API / yerel mock).
AUTH_URL=
AUTH_CLIENT_ID=

# --- Opsiyonel: DB (Faz 2 — stub fazda boş bırakılabilir) ---
DB_SQL_URL=
DB_NOSQL_URL=

# --- Opsiyonel: Mobile / Appium (Faz 4 — stub fazda boş bırakılabilir) ---
APPIUM_URL=
