{
  "name": "cross-channel-test-framework",
  "version": "0.1.0",
  "description": "Cross-channel (API + Web + Mobile + DB + Contract) test automation framework (Playwright Test)",
  "type": "commonjs",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:list": "bddgen && playwright test --list",
    "test:quarantine": "bddgen && RUN_QUARANTINE=1 playwright test --grep @quarantine",
    "test:unit": "node --require ts-node/register/transpile-only --test test/unit/*.test.ts",
    "arch:check": "depcruise src --config .dependency-cruiser.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.8.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "playwright-bdd": "^9.0.0",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0"
  }
}
