{
  "name": "cross-channel-test-framework",
  "version": "0.1.0",
  "description": "Cross-channel (API + Web + Mobile + DB + Contract) BDD test automation framework",
  "type": "commonjs",
  "scripts": {
    "features:prepare": "node scripts/prepare-features.js",
    "test": "cucumber-js",
    "pretest": "npm run features:prepare",
    "test:smoke": "cucumber-js --tags @smoke",
    "pretest:smoke": "npm run features:prepare",
    "test:regression": "cucumber-js --tags @regression",
    "pretest:regression": "npm run features:prepare",
    "test:cross-channel": "cucumber-js --tags @cross-channel",
    "pretest:cross-channel": "npm run features:prepare",
    "test:parallel": "cucumber-js --parallel 4",
    "pretest:parallel": "npm run features:prepare",
    "test:dry": "cucumber-js --dry-run",
    "pretest:dry": "npm run features:prepare",
    "test:unit": "node --require ts-node/register/transpile-only --test test/unit/*.test.ts",
    "arch:check": "depcruise src --config .dependency-cruiser.js",
    "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "allure-cucumberjs": "^3.0.0",
    "dependency-cruiser": "^16.8.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
